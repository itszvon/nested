# Public production origin. Set this on Vercel so OAuth and email links do
# not depend on request headers.
NEXT_PUBLIC_SITE_URL=

# Supabase project settings (Project Settings -> API)
# The publishable key is safe for the browser. Never put a secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google OAuth through Nested's own domain.
# When both are set, Google redirects to /auth/google/callback and the account
# chooser names this site. Without them the app falls back to Supabase's hosted
# callback. The Google Cloud OAuth client must list
#   <site origin>/auth/google/callback
# as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Remote execution for Java, C++, Go, Rust and Bash.
# Defaults to the public Judge0 CE endpoint. Point NESTED_RUNNER_URL at your
# own Judge0 instance to keep code on infrastructure you control.
NESTED_RUNNER_URL=
NESTED_RUNNER_KEY=

# Error reporting. Optional; the app also records errors in its own table.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_: that would ship
# them to the browser.
#
# CRON_SECRET gates /api/cron/backup. Vercel sends it automatically for cron
# requests. Without it the route answers 401 and no backup is written.
CRON_SECRET=
# SUPABASE_SERVICE_ROLE_KEY is used by the backup route and the error intake.
# It bypasses RLS, so it lives only in server-side code.
SUPABASE_SERVICE_ROLE_KEY=
